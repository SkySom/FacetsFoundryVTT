<section class='tab remoteDoomPools {{tab.cssClass}}' data-group='primary' data-tab='remoteDoomPools'>
  <fieldset class='remote-doom-pools-container'>
    <legend>{{localize tabs.remoteDoomPools.label}}</legend>
            {{#each parties as |party|}}
            <div class="form-group">
                <label for={{party.id}}>{{party.name}}</label>
                <div class="form-fields">
                    <select id={{party.id}} name="remoteParty.{{party.id}}"  {{#unless remoteValid}}disabled{{/unless}}>
                        {{selectOptions @root.remoteDoomPoolOptions selected=party.remoteId}}
                    </select>
                </div>
            </div>
        {{/each}}
  </fieldset>
</section>
