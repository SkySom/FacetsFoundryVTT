<section class="tab remoteCharacters {{tab.cssClass}}" data-group="primary" data-tab="remoteCharacters">
    <fieldset class="remote-characters-container">
        <legend>{{localize tabs.remoteCharacters.label}}</legend>
        {{#each characters as |character|}}
            <div class="form-group">
                <label for={{character.id}}>{{character.name}}</label>
                <div class="form-fields">
                    <select id={{character.id}} name="remoteCharacter.{{character.id}}" {{#unless @root.remoteValid}}disabled{{/unless}}>
                        {{selectOptions @root.remoteCharacterOptions valueAttr="id" labelAttr="name" selected=character.remoteId}}
                    </select>
                </div>
            </div>
        {{/each}}
    </fieldset>
</section>