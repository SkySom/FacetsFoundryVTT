<section class="tab settings {{tab.cssClass}}" data-group="primary" data-tab="settings">
    <fieldset class="settings-container">
        <legend>{{localize tabs.settings.label}}</legend>
        <div class="form-group">
            <label for="location">{{localize "FACETS.Settings.DoomAndPlot.Tab.Settings.Location.Name"}}</label>
            <div class="form-fields">
                <select id="location" name="settings.location">
                    {{selectOptions locationOptions selected=settings.location}}
                </select>
            </div>
        </div>
        <div class="form-group">
            <label for="remoteUrl">{{localize "FACETS.Settings.DoomAndPlot.Tab.Settings.RemoteUrl.Name"}}</label>
            <div class="form-fields">
                <input id="remoteUrl" name="settings.remoteUrl" type="text" placeholder="http://localhost:8080" value={{settings.remoteUrl}} />
            </div>
        </div>
        <div class="form-group">
            <label for="remoteToken">{{localize "FACETS.Settings.DoomAndPlot.Tab.Settings.RemoteToken.Name"}}</label>
            <div class="form-fields">
                <input id="remoteToken" name="settings.remoteToken" type="text" value={{settings.remoteToken}} />
            </div>
        </div>
    </fieldset>
</section>