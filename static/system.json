{
    "id": "facets",
    "title": "Facets",
    "description": "The Facets system for FoundryVTT!",
    "manifest": "https://raw.githubusercontent.com/SkySom/FacetsFoundryVTT/main/static/system.json",
    "download": "https://github.com/SkySom/FacetsFoundryVTT/releases/download/3.0.0/system.zip",
    "authors": [
        {
            "name": "Sky",
            "discord": "skysom"
        }
    ],
    "documentTypes": {
        "Actor": {
            "backgroundCharacter": {
                "htmlFields": "description"
            },
            "companion": {
                "htmlFields": "description"
            },
            "foregroundCharacter": {
                "htmlFields": "description"
            },
            "playerCharacter": {
                "htmlFields": "description"
            },
            "spotlightCharacter": {
                "htmlFields": "description"
            },
            "party": {
                "htmlFields": "description"
            }
        },
        "ChatMessage": {
            "rollResult": {}
        },
        "Item": {
            "affinity": {}
        }
    },
    "flags": {
        "hotReload": {
            "extensions": ["css", "html", "hbs", "json"],
            "paths": ["styles", "lang", "templates"]
        }
    },
    "url": "https://github.com/SkySom/FacetsFoundryVTT",
    "license": "LICENSE.txt",
    "readme": "README.md",
    "bugs": "https://github.com/SkySom/FacetsFoundryVTT/issues",
    "changelog": "CHANGELOG.md",
    "media": [
        {
            "type": "setup",
            "url": "systems/facets/assets/anvil-impact.png",
            "thumbnail": "systems/facets/assets/anvil-impact.png"
        }
    ],
    "version": "3.0.0",
    "compatibility": {
        "minimum": "14.361",
        "verified": "14.361"
    },
    "esmodules": ["facets.mjs"],
    "styles": ["styles/facets.css"],
    "languages": [
        {
            "lang": "en",
            "name": "English",
            "path": "lang/en.json"
        }
    ],
    "relationships": {
        "requires": [
            {
                "id": "_chatcommands",
                "type": "module",
                "manifest": "https://gitlab.com/woodentavern/foundryvtt-chat-command-lib/-/raw/master/src/module.json",
                "compatibility": {
                    "verified": "2.0.1"
                }
            },
            {
                "id": "socketlib",
                "type": "module",
                "manifest": "https://github.com/farling42/foundryvtt-socketlib/releases/download/v1.1.4/module.json",
                "compatibility": {
                    "verified": "v1.1.4"
                }
            }
        ]
    },
    "packs": [],
    "packFolders": [],
    "socket": true,
    "background": "systems/facets/assets/anvil-impact.png",
    "primaryTokenAttribute": "health",
    "secondaryTokenAttribute": "power"
}
